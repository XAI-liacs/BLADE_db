package components



templ ExperimentCell(experiment_data ExperimentRuns) {
    <div class="experiment-cell" id={experiment_data.Experiment.ID.String()}>
        <div class="title">
            <span class="material-symbols-outlined">experiment</span>

            <div class="title-and-date">
                <div class="name">{experiment_data.Experiment.Name}</div>

                <div class="date">
                    {experiment_data.Experiment.StartDate.Format("Jan 2, 2006 15:04")}
                    •
                    {experiment_data.Experiment.EndDate.Format("Jan 2, 2006 15:04")}
                </div>
            </div>

            <button
                type="button"
                class="neumorphic-btn accordion-toggle"
                aria-expanded="false"
                aria-label="Expand experiment"
            >
                <span class="material-symbols-outlined">keyboard_arrow_down</span>
            </button>
        </div>

        <div class="experiment-details">
            <div class="visibility neumorphic-inner">
                <span>Visibility</span>

                <button
                    type="button"
                    class="btn neumorphic-btn neumorphic-checkbox"
                ></button>
            </div>

            for _, run := range experiment_data.Runs {
	            <button
	                type="button"
	                class="run-cell btn"
	                hx-get={ "/html/run_data?run_id=" + run.ID.String() }
	                hx-target="#solution-panel"
	                hx-swap="innerHTML"
	            >
	                <div class="title">
	                    <span class="material-symbols-outlined">terminal</span>

	                    <div class="name">{ run.Name }</div>

	                    <div class="seed">
	                        Seed { run.Seed }
	                    </div>

	                    <span class="material-symbols-outlined">chevron_forward</span>
	                </div>
	            </button>
            }
        </div>
    </div>
}

templ ExperimentList(experiment_data []ExperimentRuns) {
	for _, experiment_datum := range experiment_data {
		@ExperimentCell(experiment_datum)
	}
}
