package components

import "XAI-liacs/BLADE_db/internal/database"



templ ExperimentCell(experiment database.Experiment) {
	<div class="experiment-cell" id={experiment.ID.String()}>
        <div class="title">
            <span class="material-symbols-outlined">experiment</span>

            <div class="title-and-date">
                <div class="name">{experiment.Name}</div>

                <div class="date">
                    {experiment.StartDate.Format("Jan 2, 2006 15:04")}
                    •
                    {experiment.EndDate.Format("Jan 2, 2006 15:04")}
                </div>
            </div>

            <button
                type="button"
                class="neumorphic-btn accordion-toggle"
                aria-expanded="false"
                aria-label="Expand experiment"
                hx-on:click="const details = this.closest('.experiment-cell').querySelector('.experiment-details'); if (!details.innerHTML.trim()) htmx.trigger(details, 'loadRuns')"
            >
                <span class="material-symbols-outlined">keyboard_arrow_down</span>
            </button>
        </div>

        <div
            class="experiment-details"
            id="experiment-details"
            hx-get={"/html/runs?experiment_id=" + experiment.ID.String()}
            hx-trigger="loadRuns"
            hx-swap="innerHTML">
        </div>
    </div>
}

templ ExperimentList(experiment_data []database.Experiment) {
	for _, experiment_datum := range experiment_data {
		@ExperimentCell(experiment_datum)
	}
}
