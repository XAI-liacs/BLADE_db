package components
import "XAI-liacs/BLADE_db/internal/database"

templ LLMCell(llm database.GetAllLLMsRow) {
	<div class="compact-cell neumporphic-btn"
		hx-get={ "/html/llm_info?model=" + llm.Model }
            hx-target="#right-panel"
            hx-swap="innerHTML"
            hx-on:click="
                document.querySelectorAll('.compact-cell').forEach(el => el.classList.remove('active'));
                this.closest('.compact-cell').classList.add('active');
            "
			onClick="SwitchView()">
	    <div class="cell-info">
	        <span class="material-symbols-outlined">neurology</span>
	        <span class="cell-title">
	            <span class="sub-title">{llm.Type}</span>
	            <span>{llm.Model}</span>
	        </span>
	    </div>
	    <span class="material-symbols-outlined">chevron_right</span>
	</div>
}

templ LLMList(llm_data []database.GetAllLLMsRow) {
	for _, llm_datum := range llm_data {
		@LLMCell(llm_datum)
	}
}
