package components
import "XAI-liacs/BLADE_db/internal/database"

templ LLMCell(llm database.GetAllLLMsRow) {
	<div class="llm-cell neumporphic-btn"
		hx-get={ "/html/llm_info?model=" + llm.Model }
            hx-target="#right-panel"
            hx-swap="innerHTML"
            hx-on:click="
                document.querySelectorAll('.llm-cell').forEach(el => el.classList.remove('active'));
                this.closest('.llm-cell').classList.add('active');
                const details = this.closest('.llm-cell').querySelector('.experiment-details');
                if (!details.innerHTML.trim()) htmx.trigger(details, 'loadRuns');
            "
			onClick="SwitchView()">
	    <div class="llm-info">
	        <span class="material-symbols-outlined">neurology</span>
	        <span class="llm-title">
	            <span>{llm.Model}</span>
	            <span class="sub-title">{llm.Type}</span>
	        </span>
	    </div>
	    <span class="material-symbols-outlined">chevron_right</span>
	</div>
}

templ LLMList(llm_data []database.GetAllLLMsRow) {
	for _, llm_datum := range llm_data {
		@LLMCell(llm_datum)
	}
}
