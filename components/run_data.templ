package components

import (
	"XAI-liacs/BLADE_db/internal/database"
	"github.com/google/uuid"
)



templ RunData(
	run_id uuid.UUID,
    solutions []database.GetSolutionsForRunRow,
    messages []database.GetConversationLogRow,
) {
	<div class="neumorphic-tab-container__controls" id="run-data">
	    <div class="neumorphic-tab-container__control neumorphic-tab-container__control_active" data-target="solutions">Solutions</div>
	    <div class="neumorphic-tab-container__control" data-target="conversation-log">Chat</div>
	</div>
	<div class="neumorphic-tab-container" id="run-data">
	    <div class="neumorphic-tab-container__tab neumorphic-tab-container__tab_shown" id="solutions">
		    @SolutionList(run_id, solutions)
	    </div>
	    <div class="neumorphic-tab-container__tab" id="conversation-log">
	        <div id="chat">
			    @ConversationLog(run_id, messages)
	        </div>
	    </div>
	</div>
}
