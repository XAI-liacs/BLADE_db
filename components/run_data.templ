package components

import (
	"XAI-liacs/BLADE_db/internal/database"
	"github.com/google/uuid"
)



templ RunData(
	run_id uuid.UUID,
    solutions []database.GetSolutionsForRunRow,
    messages []database.GetConversationLogRow,
) {
    @SolutionList(solutions)
    @ConversationLog(run_id, messages)
}
