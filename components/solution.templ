package components

import (
	"XAI-liacs/BLADE_db/internal/database"
	// "fmt"
)

templ Solution(solution database.GetSolutionsForRunRow) {
	{{
		parents := make([]any, 0)
		for _, parent := range solution.Parents {
			parents = append(parents, parent.String())
		}
	}}
	<div class="neumorphic-outer solution" id={solution.ID.String()}>
        <div class="title">
            <div class="name-description">
	            <span>
	                if solution.Name.Valid {
	                    { solution.Name.String }
	                } else {
	                    -
	                }
	            </span>
                <span class="sub-title">
	                if solution.Description.Valid {
	                    { solution.Description.String }
	                } else {
	                    -
	                }
                </span>
            </div>
            <div class="sub-title">
                <span>Generation:
	                if solution.Generation.Valid {
	                    { solution.Generation.Int32 }
	                } else {
	                    -
	                }
                </span>
                <span>Fitness:
	                if solution.Fitness.Valid {
	                    { string(solution.Fitness.RawMessage.String()) }
	                } else {
	                    nan
	                }
                </span>
            </div>
        </div>
        <div class="keyValuePair neumorphic-inner">
            <div class="key">Code</div>
            <code class="value">
	            <pre>
		            if solution.Code.Valid {
			            {solution.Code.String}
		            } else {
		            	...
		            }
	            </pre>
            </code>
        </div>
        <div class="keyValuePair neumorphic-inner">
            <div class="key">Metadata</div>
            <div class="value">
	                if solution.Fitness.Valid {
	                    { string(solution.Fitness.RawMessage) }
	                } else {
	                    nan
	                }
            </div>
        </div>
        if len(solution.Parents) > 0 {
	        <div class="keyValuePair neumorphic-inner">
	            <div class="key">
	                if len(solution.Parents) > 1 {
						Parents
					} else {
						Parent
					}
	            </div>

	            <button
				    type="button"
				    class="material-symbols-outlined neumorphic-btn"
					hx-on:click={ templ.JSFuncCall("ShowSolutionsInModal", parents) }
				    data-solution-id={ solution.ID.String() }>
			    north_east
			</button>
	        </div>
        }
    </div>

}


templ SolutionList(solutions []database.GetSolutionsForRunRow) {
	<div class="content-header neumorphic-outer">
        <button class="neumorphic-btn back-btn" onclick="SwitchView()">
            <span class="material-symbols-outlined">arrow_back</span>
        </button>
        <span>
            Solution
        </span>
        <button class="neumorphic-btn"
            data-toggle="modal"
            data-target="#modalView">
            <span class="material-symbols-outlined">
                sort
            </span>
        </button>
    </div>
	for _, solution := range solutions {
		@Solution(solution)
	}
}
