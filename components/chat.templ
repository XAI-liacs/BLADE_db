package components

import (
	"XAI-liacs/BLADE_db/internal/database"
	"github.com/google/uuid"
)


templ ChatBubble(message database.GetConversationLogRow) {
	<div class={ "bubble", templ.KV("left", message.ActorType == "llm"), templ.KV("right", message.ActorType != "llm") }>
        <div class="chat-head">{ message.ActorName }</div>
        <div class="message markdown-content">{ renderMarkdown(message.Message) }</div>
        <div class="date">{ message.CreatedAt.Format("Jan 2, 2006 15:04") }</div>
    </div>
}

templ ConversationLog(run_id uuid.UUID, messages []database.GetConversationLogRow) {
        if len(messages) == 0 {
		    <div
		        class="chat"
		        id="chat"
		        hx-swap-oob="outerHTML"
		    >
            	@EmptyRightPanel("No chat data found...")
			</div>
        } else {
        	<div id="chat" hx-swap-oob="outerHTML">
		       	<div class="neumorphic-outer content-header">
			        <button class="neumorphic-btn back-btn" onclick="SwitchView()">
			            <span class="material-symbols-outlined">arrow_back</span>
			        </button>
			        <span>Conversation Log</span>
			        <!-- <div class="header-spacer"></div> -->
			        <button
			            type="button"
			            class="neumorphic-btn"
			            data-toggle="modal"
			            data-target="#modalView"
			            hx-get={"/html/contributors?run_id="+run_id.String()}
			            hx-target="#modalViewContent"
			            hx-swap="innerHTML"
			        >
			            <span class="material-symbols-outlined">group</span>
			        </button>
			    </div>
			    <div class="chat">
		            for _, message := range messages {
		                @ChatBubble(message)
		            }
			    </div>
			</div>
        }
}
