package components

templ EmptyExperiment() {
	<div class="neumorphic-outer empty-view">
	    <span class="material-symbols-outlined">ios_share</span>
	    Upload an experiment to view.
	</div>
}

templ EmptyRightPanel(message string) {
	<div class="neumorphic-outer empty-view">
	    <span class="material-symbols-outlined">report</span>
		 {message}
	</div>
}
